{
  "name": "my-shibumi-app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "optimize": "bun run src/lib/optimize-images.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "drizzle-orm": "^0.31.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.22.0",
    "zod": "^3.23.0"
  }
}
