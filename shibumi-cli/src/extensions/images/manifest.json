{
  "name": "images",
  "title": "Images",
  "description": "Automatic image optimization: serves WebP on the fly, keeps originals",
  "files": [
    { "from": "files/src/middleware/images.ts", "to": "src/middleware/images.ts" }
  ],
  "agents": "agents.md",
  "hooks": [
    {
      "file": "src/app.ts",
      "find": "import { Hono } from \"hono\";",
      "insert": "import { imageMiddleware } from \"./middleware/images\";",
      "after": "export const app = new Hono();",
      "add": "\napp.use(\"/images/*\", imageMiddleware());"
    }
  ]
}
